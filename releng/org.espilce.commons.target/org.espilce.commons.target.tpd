target "Espilce Commons"

with configurePhase source

location "https://download.eclipse.org/releases/2020-06/202006171000/" {
    org.eclipse.emf.sdk.feature.group
    
    org.eclipse.xtext.sdk.feature.group
    org.eclipse.xtend.feature.group
    org.eclipse.emf.mwe.sdk.feature.group
    org.eclipse.emf.mwe2.language.sdk.feature.group
    
    org.eclipse.equinox.executable.feature.group
    org.eclipse.sdk.feature.group
}

location "https://download.eclipse.org/tools/orbit/downloads/drops/R20200529191137/repository/" {
	org.apache.commons.io
	org.apache.commons.io.source
	org.apache.commons.lang3
	org.apache.commons.lang3.source

	com.google.guava
	com.google.guava.source
	com.google.inject
	com.google.inject.source

	org.hamcrest.core
	org.hamcrest.core.source
	org.hamcrest.library
	org.hamcrest.library.source
	
	org.junit
	org.junit.source
	
	org.junit.jupiter.api
	org.junit.jupiter.api.source
	org.junit.jupiter.params
	org.junit.jupiter.params.source
	org.junit.jupiter.engine
	org.junit.jupiter.engine.source
	org.junit.jupiter.migrationsupport
	org.junit.jupiter.migrationsupport.source
	org.junit.platform.commons
	org.junit.platform.commons.source
	org.junit.platform.engine
	org.junit.platform.engine.source
	
	org.opentest4j
	org.opentest4j.source
}

location "http://download.eclipse.org/cbi/updates/license/" {
	org.eclipse.license.feature.group
}
